{
  "name": "@jadchene/mcp-ssh-service",
  "version": "3.1.1",
  "description": "SSH MCP server with explicit persistent shell sessions, idle expiry, interactive operation confirmation, and DevOps tools.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-ssh-service": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "config.example.json",
    "README_zh.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc && vite build --configLoader native --config web/vite.config.mjs",
    "test": "npm run build && node --test ./tests/handlers.test.mjs ./tests/sessions.test.mjs && npm run test:web",
    "prepare": "npm run build",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "build:web": "vite build --configLoader native --config web/vite.config.mjs",
    "test:web": "node --test tests-web/*.test.mjs",
    "verify:web-package": "node scripts/verify-web-package.mjs"
  },
  "keywords": [
    "mcp",
    "ssh",
    "model context protocol",
    "automation",
    "persistent-shell"
  ],
  "author": "jadchene",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jadchene/mcp-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/jadchene/mcp-ssh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.20.0",
    "ssh2": "^1.15.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.11.19",
    "@vitejs/plugin-vue": "^6.0.11",
    "element-plus": "^2.14.8",
    "typescript": "^5.3.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  }
}

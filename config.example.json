{
  "logDir": "./logs",
  "commandBlacklist": [
    "^apt-get upgrade",
    "curl.*\\|.*sh"
  ],
  "commandWhitelist": [
    "^systemctl status\\s+nginx$",
    "^docker ps$"
  ],
  "defaultTimeout": 60000,
  "sessionIdleTimeoutMs": 1800000,
  "maxSessions": 32,
  "allowedLocalRoots": [
    "./transfer"
  ],
  "servers": {
    "prod-web": {
      "enable": true,
      "desc": "Production Web Server (Jump Host)",
      "host": "10.0.0.5",
      "port": 22,
      "username": "deploy",
      "privateKeyPath": "./id_rsa_prod",
      "passphrase": "${SSH_KEY_PWD}",
      "strictHostKeyChecking": true,
      "hostKeySha256": "SHA256:REPLACE_WITH_SERVER_FINGERPRINT",
      "allowedRemoteRoots": [
        "/var/www/html"
      ],
      "workingDirectories": {
        "html": {
          "path": "/var/www/html",
          "desc": "Nginx Root"
        }
      },
      "proxyJump": {
        "host": "bastion.example.com",
        "port": 22,
        "username": "jumpuser",
        "password": "${JUMP_PWD}",
        "strictHostKeyChecking": true,
        "hostKeySha256": "SHA256:REPLACE_WITH_BASTION_FINGERPRINT"
      },
      "dangerMode": false,
      "codexAutoReview": false,
      "readOnly": false
    },
    "direct-ssh": {
      "enable": true,
      "desc": "Direct SSH with Password",
      "host": "192.168.1.59",
      "username": "root",
      "password": "${SERVER_PWD}",
      "hostKeySha256": "SHA256:REPLACE_WITH_SERVER_FINGERPRINT",
      "dangerMode": false,
      "codexAutoReview": false,
      "port": 22,
      "readOnly": false,
      "strictHostKeyChecking": true
    },
    "test-db": {
      "enable": true,
      "desc": "Read-only Test Database",
      "host": "192.168.1.50",
      "username": "tester",
      "password": "${TEST_DB_PASSWORD}",
      "hostKeySha256": "SHA256:REPLACE_WITH_SERVER_FINGERPRINT",
      "readOnly": true,
      "dangerMode": false,
      "codexAutoReview": false,
      "port": 22,
      "strictHostKeyChecking": true
    }
  }
}
